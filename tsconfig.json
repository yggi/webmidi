{
  // Lifted from yggi/cells tsconfig.json @ 41ef16b: the full typecheck, tests and tools with Node's types, and the DOM's
  // for `web` and its tests (core is held to none by tsconfig.pure.json).
  "compilerOptions": {
    "resolveJsonModule": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tools/**/*.ts", "vitest.config.ts"]
}
