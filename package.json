{
  "name": "@yggi/webmidi",
  "version": "0.1.0",
  "description": "The family's MIDI layer: messages in, ports, the clock offset, note and clock out (core, pure); the Web MIDI adapter, SysEx too (web); shared Svelte components to come.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./core": {
      "types": "./types/core/index.d.ts",
      "default": "./src/core/index.ts"
    },
    "./web": {
      "types": "./types/web/index.d.ts",
      "default": "./src/web/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/fixtures.ts",
    "types",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "check": "tsc -p tsconfig.pure.json && tsc -p tsconfig.web.json && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "preverify": "node tools/install-first.mjs && sh tools/verified.sh begin",
    "verify": "npm run check && npm run lint && npm run format:check && npm run knip && npm test",
    "postverify": "sh tools/verified.sh end",
    "types": "tsc -p tsconfig.types.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
