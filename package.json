{
  "name": "@yggi/webmidi",
  "version": "0.2.1",
  "description": "The family's MIDI layer: messages in, ports, the clock offset, note and clock out (core, pure); the Web MIDI adapter, SysEx too (web); the patchbay's shared Svelte 5 components (ui).",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./core": {
      "types": "./types/core/index.d.ts",
      "default": "./src/core/index.ts"
    },
    "./web": {
      "types": "./types/web/index.d.ts",
      "default": "./src/web/index.ts"
    },
    "./ui": {
      "types": "./types/ui/index.d.ts",
      "svelte": "./src/ui/index.ts",
      "default": "./src/ui/index.ts"
    },
    "./testing": {
      "types": "./types/testing/index.d.ts",
      "default": "./src/testing/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "types",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "check": "tsc -p tsconfig.pure.json && tsc -p tsconfig.web.json && svelte-check --tsconfig ./tsconfig.ui.json --fail-on-warnings && tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "preverify": "node tools/install-first.mjs && sh tools/verified.sh begin",
    "verify": "npm run check && npm run lint && npm run format:check && npm run knip && npm test -- --reporter=default --reporter=./tools/test-count.ts",
    "postverify": "sh tools/verified.sh end",
    "verify:docs": "npm run format:check && vitest run src/docs.test.ts tools/reading-list.test.ts tools/docs-only.test.ts tools/conflict-markers.test.ts",
    "types": "tsc -p tsconfig.types.json && node tools/ui-types.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.40.0",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "svelte2tsx": "^0.7.63",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  }
}
